# Скопируй в .env и заполни. Без ключей студия работает в демо-режиме:
# сценарии-заглушки, цветные кадры вместо картинок и тишина вместо голоса.

# --- Сериал по умолчанию (файл series/<slug>.json) ---
STUDIO_SERIES=bozor-seriali

# --- Claude: идеи, сценарии, хуки, промпты, проверка качества, аналитика ---
# Есть ключ — работают настоящие агенты. Нет ключа — демо-режим.
ANTHROPIC_API_KEY=
# LLM_PROVIDER=claude            # claude | mock (по умолчанию: claude, если ключ задан)
# CLAUDE_MODEL=claude-opus-5-5

# --- Движки кадров и видео: подключи хотя бы один ---
# auto выбирает первый подключённый: Gemini → Grok → Higgsfield → fal.ai. Без ключей — демо.
# IMAGE_ENGINE=auto
# VIDEO_ENGINE=auto

# Gemini (Google AI Studio): кадры — Nano Banana 2.1, видео — Gemini Omni Flash (~$0.07 за секунду 720p)
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# GEMINI_VIDEO_MODEL=gemini-omni-1.2-flash

# Grok (xAI): кадры — grok-imagine-image-2.0, видео — grok-imagine-video-1.5 (стоимость приходит в ответе)
XAI_API_KEY=
# GROK_VIDEO_MODEL=grok-imagine-video-1.5-lite   # дешевле за секунду
# GROK_VIDEO_RESOLUTION=720p

# Higgsfield: кадры — Soul, видео — Kling 3.0 (ключ в виде ID и SECRET из console.higgsfield.ai)
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
# HIGGSFIELD_VIDEO_ENDPOINT=kling-video/v3.0/std/image-to-video

# fal.ai: кадры — Flux, видео — Kling
FAL_KEY=
# FAL_IMAGE_MODEL=fal-ai/flux/dev
# FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video

# --- Azure Speech: озвучка на узбекском (№ 51) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# TTS_COST_PER_CHAR_USD=0.000016

# --- Telegram: пульт одобрения (№ 80) ---
TELEGRAM_BOT_TOKEN=
# Твой chat id: напиши боту /start, затем открой https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ADMIN_CHAT_ID=

# --- Instagram Graph API: публикация (№ 81) и статистика (№ 91) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
# IG_GRAPH_VERSION=v23.0
# IG_GRAPH_HOST=graph.facebook.com   # или graph.instagram.com, если токен получен через вход Instagram
# IG_INSIGHT_METRICS=views,reach,likes,comments,shares,saved

# --- Сервер ---
PORT=8080
# Публичный адрес сервера: Instagram скачивает ролик по ссылке PUBLIC_BASE_URL/media/...
PUBLIC_BASE_URL=
# Пароль панели управления (логин: admin)
STUDIO_ADMIN_PASSWORD=

# --- Деньги и расписание ---
DAILY_BUDGET_USD=5
# Ежедневный запуск в это время (пусто = выключено)
DAILY_AT=09:00
STUDIO_TZ=Asia/Tashkent
EPISODES_PER_DAY=1
