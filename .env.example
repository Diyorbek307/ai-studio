# Скопируй в .env и заполни. Без ключей студия работает в демо-режиме:
# сценарии-заглушки, перекладка из картинок героев и тишина вместо голоса.
#
# БЕСПЛАТНЫЙ СТАРТ: достаточно одного ключа GEMINI_API_KEY (aistudio.google.com → Get API key).
#   мозг — Gemini Flash (бесплатный тариф), голоса — Gemini TTS (узбекский и русский, бесплатно),
#   кадры и анимация — перекладка из картинок героев (работает на сервере, $0 за серию).

# --- Сериал по умолчанию (файл series/<slug>.json) ---
STUDIO_SERIES=bozor-seriali

# --- Мозг студии: идеи, сценарии, хуки, промпты, проверка качества, аналитика ---
# Порядок по умолчанию: Claude, если есть ключ → Gemini, если есть ключ → демо.
ANTHROPIC_API_KEY=
# LLM_PROVIDER=gemini            # claude | gemini | mock
# CLAUDE_MODEL=claude-opus-5-5

# Gemini (Google AI Studio). Один ключ даёт бесплатный мозг и бесплатные голоса.
GEMINI_API_KEY=
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Картинки и видео Gemini платные — включаются явно (Nano Banana 2.1 и Omni Flash, ~$0.07 за секунду 720p):
# GEMINI_MEDIA=on

# --- Кадры и видео ---
# cutout (перекладка) — бесплатно: фон места + герои, говорящий подпрыгивает в такт реплике, камера едет.
#   Картинки героев загружаются во вкладке «Бренды» (PNG с прозрачным фоном; белый фон уберётся сам).
# auto выбирает первый подключённый платный движок: Grok → Higgsfield → Gemini → fal.ai, иначе перекладку.
# IMAGE_ENGINE=auto              # auto | cutout | gemini | grok | higgsfield | fal | mock
# VIDEO_ENGINE=auto

# Grok (xAI): кадры — grok-imagine-image-2.0, видео — grok-imagine-video-1.5 (стоимость приходит в ответе)
XAI_API_KEY=
# GROK_VIDEO_MODEL=grok-imagine-video-1.5-lite   # дешевле за секунду
# GROK_VIDEO_RESOLUTION=720p

# Higgsfield: кадры — Soul, видео — Kling 3.0 (ключ в виде ID и SECRET из console.higgsfield.ai)
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
# HIGGSFIELD_VIDEO_ENDPOINT=kling-video/v3.0/std/image-to-video

# fal.ai: кадры — Flux, видео — Kling
FAL_KEY=
# FAL_IMAGE_MODEL=fal-ai/flux/dev
# FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video

# --- Голоса (№ 51) ---
# Порядок по умолчанию: Azure, если есть ключ → Gemini TTS, если есть GEMINI_API_KEY → демо-тишина.
# TTS_PROVIDER=gemini            # azure | gemini | mock
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# TTS_COST_PER_CHAR_USD=0.000016

# --- Telegram: пульт одобрения (№ 80) и бот для клиентов ---
TELEGRAM_BOT_TOKEN=
# Твой chat id: напиши боту /start, затем открой https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ADMIN_CHAT_ID=
# Имя бота без @ — для кнопки «Подключить Telegram» в кабинете клиента (иначе студия узнает его сама)
# TELEGRAM_BOT_USERNAME=
# Канал собственного сериала студии: бот (админ канала) публикует туда одобренные серии
# TELEGRAM_CHANNEL=@bozor_seriali

# --- Instagram Graph API: публикация (№ 81) и статистика (№ 91) собственного сериала студии ---
# Сериалы клиентов публикуются только в Instagram клиента — его ключи задаются в карточке клиента.
IG_USER_ID=
IG_ACCESS_TOKEN=
# IG_GRAPH_VERSION=v23.0
# IG_GRAPH_HOST=graph.facebook.com   # или graph.instagram.com, если токен получен через вход Instagram
# IG_INSIGHT_METRICS=views,reach,likes,comments,shares,saved

# --- Сервер, вход и кабинеты клиентов ---
PORT=8080
# Публичный адрес сервера: по нему Instagram скачивает ролик, по нему же строятся ссылки-приглашения
PUBLIC_BASE_URL=
# Пароль владельца студии (логин: admin). Клиенты входят по почте и своему паролю.
STUDIO_ADMIN_PASSWORD=
# Ключ подписи сессий (32+ символа). Пусто — студия сама создаст его в data/.session-secret
# STUDIO_SESSION_SECRET=

# --- Реквизиты студии для счетов на оплату (вкладка «Клиенты» → «Счёт») ---
# STUDIO_LEGAL_NAME=ООО «AI Studio»
# STUDIO_INN=
# STUDIO_ADDRESS=
# STUDIO_BANK=
# STUDIO_ACCOUNT=
# STUDIO_MFO=
# STUDIO_PHONE=
# STUDIO_DIRECTOR=
# Курс доллара в сумах: задан — счёт в сумах (с суммой в долларах для справки), пусто — в долларах
# STUDIO_USD_RATE=
# STUDIO_VAT_NOTE=Без НДС

# --- Деньги и расписание ---
DAILY_BUDGET_USD=5
# Ежедневный запуск: свой сериал + автопилот клиентов по тарифу (пусто = выключено)
DAILY_AT=09:00
STUDIO_TZ=Asia/Tashkent
EPISODES_PER_DAY=1
