{
  "name": "ai-studio",
  "version": "0.1.0",
  "description": "AI-студия: агенты, которые делают короткие ролики для Instagram",
  "main": "dist/src/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "studio": "node dist/src/cli.js",
    "serve": "node dist/src/cli.js serve",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/test/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  }
}
